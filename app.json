{
  "expo": {
    "name": "BugBaas Reservaat - Preview",
    "slug": "bugbaas-reservaat",
    "version": "0.1.20",
    "orientation": "portrait",
    "scheme": "bugbaas-reservaat",
    "plugins": [
      "./plugins/withReleaseConfig",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BugBaas gebruikt je locatie om bugs in de buurt te tonen en je wandelafstand te meten.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/withAdventureSync"
    ],
    "icon": "./assets/v2/ui/app-icon-v2.png",
    "backgroundColor": "#12382e",
    "userInterfaceStyle": "light",
    "android": {
      "package": "nl.cimpro.bugbaas.reservaat.preview",
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/v2/ui/app-icon-foreground-v2.png",
        "backgroundColor": "#12382e"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "name": "BugBaas Reservaat",
      "favicon": "./assets/v2/ui/app-icon-v2.png"
    },
    "splash": {
      "backgroundColor": "#12382e",
      "image": "./assets/v2/ui/app-icon-foreground-v2.png",
      "resizeMode": "contain"
    }
  }
}
