# Local preview; real cloud credentials belong only in the server environment.
GAME_STORE=sqlite
GAME_LOCAL_PORT=8086
# Emulator uses 10.0.2.2. A physical phone needs the local computer address.
EXPO_PUBLIC_GAME_API_URL=http://10.0.2.2:8086
# For cloud mode: GAME_STORE=firestore; FIREBASE_PROJECT_ID; GOOGLE_APPLICATION_CREDENTIALS
# The new project ID must never be the old BugBaas project.
# Vercel server only: FIREBASE_SERVICE_ACCOUNT_JSON (never EXPO_PUBLIC_).
# Signed test APK: EXPO_PUBLIC_GAME_API_URL=https://bugbaas-reservaat-preview.vercel.app
